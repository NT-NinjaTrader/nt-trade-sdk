{
  "name": "nt-trade-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the NinjaTrader Trade API and Market Data API.",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:ts": "tsx scripts/build-ts.ts",
    "example:basic": "tsx examples/basic-trading.ts",
    "example:md": "tsx examples/market-data.ts",
    "example:pl": "tsx examples/simple-pl-calculator.ts",
    "example:liquidate": "tsx examples/liquidate-positions.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js --fix",
    "lint:check": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run tests/",
    "generate:env": "tsx scripts/generate-env.ts",
    "docs": "typedoc --options typedoc.json",
    "docs:html": "typedoc --options typedoc.html.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "docs:serve": "npm run docs:html && cd docs/html && python3 -m http.server 8080"
  },
  "devDependencies": {
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^1.2.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "happy-dom": "^13.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "eventemitter3": "^5.0.1",
    "winston": "^3.17.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
